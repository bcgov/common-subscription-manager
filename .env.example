# Template for the git-ignored .env that Docker Compose passes to the backend.
#
#   cp .env.example .env
#
# Every backend setting that differs per environment belongs here, with a value that works
# with the local stack in docker-compose.yml. Secrets for real services stay blank.
# Database connection settings aren't here: docker-compose.yml wires those between containers.

# Sign-in for people using CHOSEN's UI. Locally this is the keycloak container's standard
# realm (users admin/admin and staff/staff). Tokens name localhost as their issuer, which the
# backend container can't reach, so it fetches the realm's keys from the container directly.
KEYCLOAK_ISSUER=http://localhost:4880/realms/standard
KEYCLOAK_CLIENT_ID=chosen-local
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/standard/protocol/openid-connect/certs
# To use real DEV SSO instead, replace the three lines above with:
# KEYCLOAK_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
# KEYCLOAK_CLIENT_ID=chosen-6820

# CSTAR, which says which tenants a signed-in user belongs to and their CHOSEN roles there.
# Locally this is the cstar-mock container; edit local/cstar-mock/data.json to change who
# belongs where. Not used by the backend yet.
CSTAR_API_URL=http://cstar-mock:3003

# Issuing tenants' client credentials. Locally this is the aps-mock container. Not used by
# the backend yet.
APS_API_BASE_URL=http://aps-mock:3002/ds/api/v3
APS_TOKEN_URL=http://aps-mock:3002/token
APS_GATEWAY_ID=gw-local
APS_ENVIRONMENT_APP_ID=LOCAL001
APS_CLIENT_ID=local-aps-service-account
APS_CLIENT_SECRET=local-aps-secret
# To test against the real API Services Portal (CHOSEN's dev environment) instead. Every
# credential issued there is a permanent consumer on the gateway, so do this sparingly:
# APS_API_BASE_URL=https://api.gov.bc.ca/ds/api/v3
# APS_TOKEN_URL=https://authz.apps.gov.bc.ca/auth/realms/aps/protocol/openid-connect/token
# APS_GATEWAY_ID=gw-a88e8
# APS_ENVIRONMENT_APP_ID=D5C97345
# APS_CLIENT_ID=sa-gw-a88e8-ca853245-8c0ba7dc30ba
# APS_CLIENT_SECRET=   (from the password manager)
