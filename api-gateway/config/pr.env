# PR environments, in the DEV namespace. They share the dev hostname and the dev product
# environment, told apart by a /pr-<number> path prefix. Set PR_NUMBER when generating.
ENVIRONMENT=dev
GATEWAY_ID=gw-a88e8
SERVICE_NAME=chosen-pr-${PR_NUMBER}
ROUTE_PREFIX=gw-a88e8-pr-${PR_NUMBER}-
CONFIG_TAG=ns.gw-a88e8.dev
GATEWAY_HOSTNAME=chosen.dev.api.gov.bc.ca
PATH_PREFIX=/pr-${PR_NUMBER}
# OpenShift Service: ${NAME}-${ZONE}-backend in the DEV namespace. Set LICENSE_PLATE once
# the namespace exists.
LICENSE_PLATE=
BACKEND_HOST=chosen-${PR_NUMBER}-backend.${LICENSE_PLATE}-dev.svc.cluster.local
BACKEND_PORT=80
SERVICE_TOKEN_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/apigw
SERVICE_TOKEN_AUDIENCE=ap-gw-a88e8-default-dev
USER_TOKEN_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
USER_TOKEN_AUDIENCE=chosen-6820
# Where CHOSEN's frontend runs; Kong lets only these call the UI and public routes.
FRONTEND_ORIGINS=https://chosen-${PR_NUMBER}.apps.silver.devops.gov.bc.ca
RATE_LIMIT_POLICY=redis
SERVICE_RATE_LIMIT_PER_MINUTE=6000
PUBLIC_RATE_LIMIT_PER_MINUTE=60
