# PROD. Its product environment isn't in gateway-setup.yaml yet.
ENVIRONMENT=prod
GATEWAY_ID=gw-a88e8
SERVICE_NAME=chosen-prod
ROUTE_PREFIX=gw-a88e8-prod-
CONFIG_TAG=ns.gw-a88e8.prod
GATEWAY_HOSTNAME=chosen.api.gov.bc.ca
PATH_PREFIX=
# OpenShift Service: ${NAME}-${ZONE}-backend in the PROD namespace. Set LICENSE_PLATE once
# the namespace exists.
LICENSE_PLATE=
BACKEND_HOST=chosen-prod-backend.${LICENSE_PLATE}-prod.svc.cluster.local
BACKEND_PORT=80
SERVICE_TOKEN_ISSUER=https://loginproxy.gov.bc.ca/auth/realms/apigw
SERVICE_TOKEN_AUDIENCE=ap-gw-a88e8-default-prod
USER_TOKEN_ISSUER=https://loginproxy.gov.bc.ca/auth/realms/standard
USER_TOKEN_AUDIENCE=chosen-6820
# Where CHOSEN's frontend runs; Kong lets only these call the UI and public routes.
FRONTEND_ORIGINS=https://chosen-prod.apps.silver.devops.gov.bc.ca
RATE_LIMIT_POLICY=redis
SERVICE_RATE_LIMIT_PER_MINUTE=6000
PUBLIC_RATE_LIMIT_PER_MINUTE=60
