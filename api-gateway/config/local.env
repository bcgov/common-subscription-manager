# Local Kong in Docker Compose. jwt-keycloak isn't in the stock Kong image, so the
# generator drops it locally; the backend still verifies every token.
ENVIRONMENT=local
GATEWAY_ID=gw-local
SERVICE_NAME=chosen-local
ROUTE_PREFIX=chosen-local-
CONFIG_TAG=ns.gw-local.local
GATEWAY_HOSTNAME=
PATH_PREFIX=
BACKEND_HOST=backend
BACKEND_PORT=3000
SERVICE_TOKEN_ISSUER=http://localhost:4880/realms/apigw
SERVICE_TOKEN_AUDIENCE=ap-gw-local-default-local
USER_TOKEN_ISSUER=http://localhost:4880/realms/standard
USER_TOKEN_AUDIENCE=chosen-local
# Where CHOSEN's frontend runs; Kong lets only these call the UI and public routes.
FRONTEND_ORIGINS=http://localhost:4000,http://localhost:4005
RATE_LIMIT_POLICY=local
SERVICE_RATE_LIMIT_PER_MINUTE=6000
PUBLIC_RATE_LIMIT_PER_MINUTE=60
