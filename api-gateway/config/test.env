# TEST. Its product environment isn't in gateway-setup.yaml yet.
ENVIRONMENT=test
GATEWAY_ID=gw-a88e8
SERVICE_NAME=chosen-test
ROUTE_PREFIX=gw-a88e8-test-
CONFIG_TAG=ns.gw-a88e8.test
GATEWAY_HOSTNAME=chosen.test.api.gov.bc.ca
PATH_PREFIX=
# OpenShift Service: ${NAME}-${ZONE}-backend in the TEST namespace. Set LICENSE_PLATE once
# the namespace exists.
LICENSE_PLATE=
BACKEND_HOST=chosen-test-backend.${LICENSE_PLATE}-test.svc.cluster.local
BACKEND_PORT=80
SERVICE_TOKEN_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/apigw
SERVICE_TOKEN_AUDIENCE=ap-gw-a88e8-default-test
USER_TOKEN_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/standard
USER_TOKEN_AUDIENCE=chosen-6820
# Where CHOSEN's frontend runs; Kong lets only these call the UI and public routes.
FRONTEND_ORIGINS=https://chosen-test.apps.silver.devops.gov.bc.ca
RATE_LIMIT_POLICY=redis
SERVICE_RATE_LIMIT_PER_MINUTE=6000
PUBLIC_RATE_LIMIT_PER_MINUTE=60
