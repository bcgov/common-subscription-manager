{
  "realm": "apigw",
  "displayName": "Local stand-in for BC Gov SSO's apigw realm (client credentials)",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "LOCAL001-NOTIFY",
      "name": "Notify (local)",
      "description": "Stands in for Notify's system credentials. Tenant credentials are created through the APS mock.",
      "publicClient": false,
      "secret": "local-notify-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ap-gw-local-default-local",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
